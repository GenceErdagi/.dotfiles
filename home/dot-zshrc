export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

plugins=(
  git
  sudo
  systemd
  rsync
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# Ashen theme for zsh-syntax-highlighting (must load AFTER oh-my-zsh)
source ~/.config/zsh/ashen_zsh_syntax_highlighting.zsh

# Ashen theme for fzf
source ~/.config/fzf/ashen.sh

# eza: unset LS_COLORS so theme.yml is respected
unset LS_COLORS

# Editor
export EDITOR="$HOME/.cargo/bin/hx"

# PATH additions
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

export DOTNET_ROOT=$HOME/.dotnet
export PATH=$PATH:$DOTNET_ROOT:$DOTNET_ROOT/tools

# Rust
source "$HOME/.cargo/env"

# fnm (Fast Node Manager)
export FNM_PATH="$HOME/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"
  eval "$(fnm env --shell zsh)"
fi

# Zoxide (cd replacement)
eval "$(zoxide init zsh --cmd cd)"

# Oh My Posh prompt
eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/oh-my-posh-theme.json)"

# Zellij auto-start
export ZELLIJ_AUTO_ATTACH=true
export ZELLIJ_AUTO_EXIT=false
eval "$(zellij setup --generate-auto-start zsh)"

# yazi function: cd on quit
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# Disable greeting
DISABLE_AUTO_TITLE="true"

# eza aliases
alias ls="eza -G --icons --group-directories-first"
alias la="eza -Ga --icons --group-directories-first"
alias ll="eza -lh --icons --git --group-directories-first"
