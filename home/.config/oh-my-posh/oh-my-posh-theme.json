{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#d5d5d5",
          "options": {
            "alpine": "\uf300",
            "arch": "\uf303",
            "centos": "\uf304",
            "debian": "\uf306",
            "elementary": "\uf309",
            "fedora": "\uf30a",
            "gentoo": "\uf30d",
            "linux": "\ue712",
            "macos": "\ue711",
            "manjaro": "\uf312",
            "mint": "\uf30f",
            "opensuse": "\uf314",
            "raspbian": "\uf315",
            "ubuntu": "\uf31c",
            "windows": "\ue70f"
          },
          "style": "plain",
          "template": "<#c4693d>┏[</>\u2009{{ .Icon }}\u2009<#c4693d>]</>",
          "type": "os"
        },
        {
          "foreground": "#d5d5d5",
          "style": "plain",
          "template": "<#c4693d>[</>\u2009{{ .UserName }}\u2009<#c4693d>]</>",
          "type": "session"
        },
        {
          "foreground": "#e5a72a",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#c53030{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#d87c4a{{ end }}",
            "{{ if gt .Ahead 0 }}#b14242{{ end }}",
            "{{ if gt .Behind 0 }}#b14242{{ end }}"
          ],
          "options": {
            "branch_icon": "\uf418 ",
            "branch_identical_icon": "\uf444",
            "branch_gone_icon": "\ueab8",
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true
          },
          "style": "plain",
          "template": "<#c4693d>[</>\u2009{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} | \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} | \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} | \ueb4b {{ .StashCount }}{{ end }}\u2009<#c4693d>]</>",
          "type": "git"
        },
        {
          "foreground": "#d5d5d5",
          "style": "plain",
          "template": "<#c4693d>[</>\u2009\uf0e7\u2009<#c4693d>]</>",
          "type": "root"
        },
        {
          "foreground": "#c53030",
          "style": "plain",
          "template": "<#c4693d>[</>\u2009x {{ reason .Code }}\u2009<#c4693d>]</>",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "foreground": "#d5d5d5",
          "options": {
            "always_enabled": true,
            "style": "austin"
          },
          "style": "plain",
          "template": "<#c4693d>[</>\u2009\ueba2 {{ .FormattedMs }}\u2009<#c4693d>]</>",
          "type": "executiontime"
        },
        {
          "foreground": "#c4693d",
          "options": {
            "time_format": "15:04:05"
          },
          "style": "plain",
          "template": "<#c4693d>[</>\u2009\uf073 {{ .CurrentDate | date .Format }}\u2009<#c4693d>]</>",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#4a8b8b",
          "options": {
            "folder_icon": "…",
            "folder_separator_icon": " \ue0b1 ",
            "max_depth": 3,
            "style": "agnoster_short"
          },
          "style": "plain",
          "template": "<#c4693d>┖[</>\u2009{{ .Path }}\u2009<#c4693d>]</>",
          "type": "path"
        },
        {
          "foreground": "#c4693d",
          "style": "plain",
          "template": "{{ if .Root }}#{{else}}~>{{end}}",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
